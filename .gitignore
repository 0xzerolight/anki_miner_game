.worktrees/
.orchestration/
# No trailing slash: each worktree's .venv/.venv-vad is a SYMLINK to the
# shared venv in the main checkout, and a trailing-slash pattern only matches
# a real directory, never a symlink to one.
.venv
.venv-vad
.venv-build

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
gate.log
